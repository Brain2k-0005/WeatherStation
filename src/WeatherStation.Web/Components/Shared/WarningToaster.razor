@implements IDisposable
@inject WeatherSystem Weather
@inject ToastService Toast

@* Unsichtbare Komponente: zeigt jede Warnung ab Stufe "Warnung" als Toast (Hinweis-Meldung)
   an, egal auf welcher Seite man gerade ist. Sie steht deshalb im MainLayout. *@

@code {
    private IWeatherObserver<WeatherWarning>? _observer;
    private bool _disposed;

    protected override void OnInitialized()
    {
        // ============================================================
        // PATTERN: Observer - Rolle: Abonnent (mit Filter)
        // Der FilterObserver ist eine Hülle um den eigentlichen Observer: Der Toaster
        // bekommt nur Warnungen der Stufe Warning und Danger. Reine Hinweise (Info)
        // und Entwarnungen erreichen ihn gar nicht erst.
        // Die Referenz im Feld _observer MUSS man behalten: Nur mit demselben Objekt
        // kann man sich in Dispose wieder abmelden (Unsubscribe). Sonst: Speicherleck.
        // ============================================================
        _observer = new FilterObserver<WeatherWarning>(
            new ActionObserver<WeatherWarning>("Toast-Anzeige", ShowToast),
            warning => warning.Level >= WarningLevel.Warning);
        Weather.Warnings.Subscribe(_observer);
    }

    // ------------------------------------------------------------
    // FÜR FORTGESCHRITTENE – beim ersten Lesen überspringen.
    // Blazor-spezifisch: Meldungen kommen aus dem Hintergrund-Thread. InvokeAsync wechselt
    // in den UI-Kontext, das _disposed-Flag fängt Meldungen ab, die noch "unterwegs" sind.
    // ------------------------------------------------------------
    private void ShowToast(WeatherWarning warning)
    {
        // Diese Methode wird vom Hintergrund-Thread der Simulation aufgerufen,
        // nicht vom UI-Thread. InvokeAsync wechselt in den richtigen Kontext.
        // Ohne InvokeAsync würde Blazor eine Exception werfen.
        InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            if (warning.Level == WarningLevel.Danger)
            {
                Toast.Error(warning.Title, warning.Message);
            }
            else
            {
                Toast.Warning(warning.Title, warning.Message);
            }
        });
    }

    public void Dispose()
    {
        // Abmelden! Sonst bleibt diese Komponente für immer beim (Singleton-)Warn-Dienst
        // angemeldet: ein Speicherleck, und Meldungen gehen an eine tote Komponente.
        _disposed = true;
        Weather.Warnings.Unsubscribe(_observer!);
    }
}
