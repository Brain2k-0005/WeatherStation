@implements IDisposable
@inject NavigationManager Nav

@* Einfacher Seitentitel, aus derselben Liste wie die Sidebar (AppNavigation). *@
<Lumeo.Text As="span" Size="sm" Weight="medium" Truncate="true">@CurrentTitle</Lumeo.Text>

@code {
    // Titel kommt aus AppNavigation, damit er auch auf Unterseiten (/muster/observer) stimmt.
    private string CurrentTitle => AppNavigation.TitleFor(Nav.ToBaseRelativePath(Nav.Uri));

    protected override void OnInitialized()
    {
        // Bei jedem Seitenwechsel muss der Titel neu gezeichnet werden.
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Abmelden, sonst hält der NavigationManager (lebt so lange wie die Verbindung)
        // diese Komponente für immer im Speicher.
        Nav.LocationChanged -= OnLocationChanged;
    }
}
