@page "/muster"

<PageTitle>Design Patterns - Wetterstation</PageTitle>

@* Übersicht der Lernseiten. Die Texte stehen in Services/PatternContent.cs, jede Karte führt
   zur ausführlichen Erklärung (/muster/observer usw.). Die Seite zeigt nur Text und braucht
   deshalb weder Abonnement noch Dispose. *@
<div class="flex flex-col gap-4">

    @* --- Lernpfad --- *@
    <PatternCard Title="Lernpfad" Description="Empfohlene Reihenfolge: erst die kleine Stufe 1 verstehen, dann Observer, dann der Rest, zum Schluss der Code-Rundgang.">
        <div class="flex flex-col gap-2 md:flex-row md:items-center">
            <DiagramBox Title="Stufe 1" Sub="Beginner-Projekt: Observer in klein" />
            <DiagramArrow />
            <DiagramBox Title="Observer" Sub="das wichtigste Muster" Highlight="true" />
            <DiagramArrow />
            <DiagramBox Title="Builder, Factory Method, Singleton" Sub="in beliebiger Reihenfolge" />
            <DiagramArrow />
            <DiagramBox Title="Code-Rundgang" Sub="docs/CODE-RUNDGANG.md: folge einem Messwert" />
        </div>
    </PatternCard>

    @* --- Die vier Muster --- *@
    <div class="grid gap-4 lg:grid-cols-2">
        @foreach (PatternInfo pattern in PatternCatalog.All)
        {
            <Card Variant="Card.CardVariant.Outline" Class="ws-card gap-0 py-0">
                <CardHeader Class="!px-4 !py-3 border-b border-border">
                    <CardTitle Class="text-base font-semibold leading-snug">@pattern.Title</CardTitle>
                    <CardDescription>@pattern.OneLiner</CardDescription>
                </CardHeader>
                <CardContent Class="!p-4 flex h-full flex-col justify-between gap-3 text-sm">
                    <div>
                        <div class="font-medium">Wann brauche ich das?</div>
                        <p class="mt-1 text-muted-foreground">@pattern.WhenNeeded</p>
                    </div>
                    <div>
                        <Button Variant="Button.ButtonVariant.Outline" Size="Button.ButtonSize.Sm" Href="@pattern.Href">
                            Zur Erklärung
                            <SvgGlyph Svg="@(Lucide.ArrowRight)" Class="h-3.5 w-3.5" />
                        </Button>
                    </div>
                </CardContent>
            </Card>
        }
    </div>
</div>
