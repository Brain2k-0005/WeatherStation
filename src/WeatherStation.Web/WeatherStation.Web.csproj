<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\WeatherStation.Core\WeatherStation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lumeo" Version="5.12.2" />
    <PackageReference Include="Lumeo.Charts" Version="5.12.2" />
    <PackageReference Include="Lumeo.DataGrid" Version="5.12.2" />
    <PackageReference Include="Lumeo.Icons.Lucide" Version="5.12.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Tailwind-v4-Build: wwwroot/css/site.css (Quelle) -> wwwroot/css/site.out.css (Ergebnis).
       package.json liegt im Lösungsordner. Wird übersprungen, wenn node_modules fehlt,
       damit "dotnet build" auch ohne Node funktioniert (die fertige site.out.css liegt im Repo).
       Nach dem ersten Checkout: "npm install" im Lösungsordner ausfuehren. -->
  <Target Name="BuildTailwindCss" BeforeTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/../../node_modules')">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
